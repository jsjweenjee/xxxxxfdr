--// Function to send to Discord
local function sendDungeonNotification(dungeonName, threatLevel)
	local data = {
		username = "ARISE Dungeon Notifier",
		avatar_url = "https://i.imgur.com/Bs6Rc0L.png", -- optional Arise-themed icon
		embeds = {{
			title = "**New Dungeon Detected!**",
			description = string.format("**Dungeon Name:** %s\n**Threat Level:** %s", dungeonName, threatLevel),
			color = 11730954, -- Purple/black Arise theme
			footer = {
				text = "Solo Leveling: Arise x Dungeon Notifier"
			},
			timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ") -- UTC format
		}}
	}

	local success, err = pcall(function()
		HttpService:PostAsync(webhookUrl, HttpService:JSONEncode(data), Enum.HttpContentType.ApplicationJson)
	end)

	if not success then
		warn("Failed to send Discord notification:", err)
	end
end

